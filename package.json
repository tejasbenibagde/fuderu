{
  "name": "fuderu",
  "version": "0.2.0",
  "type": "module",
  "description": "High-performance canvas drawing library with Rust-powered brush engine",
  "main": "./dist/index.umd.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "canvas",
    "drawing",
    "brush",
    "painting",
    "wasm",
    "rust"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.umd.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage"
  },
  "author": "tejasbenibagde",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "jsdom": "^24.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}